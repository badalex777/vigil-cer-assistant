# Copy to .env (Replit: use the Secrets tab instead) and fill in.

# Required for screening / extraction / drafting
ANTHROPIC_API_KEY=sk-ant-...

# Optional but recommended: raises NCBI rate limit 3 -> 10 req/s
# https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
NCBI_EMAIL=you@example.com

# Used for open-access full-text retrieval via Unpaywall (free; just needs an email).
# Defaults to NCBI_EMAIL if unset. https://unpaywall.org/products/api
UNPAYWALL_EMAIL=you@example.com
# Set to 0 to disable auto-retrieval (PMC/Unpaywall) and upload everything manually.
VIGIL_AUTO_RETRIEVAL=1

# Optional overrides
# VIGIL_MODEL_SCREEN=claude-sonnet-4-6
# VIGIL_MODEL_EXTRACT=claude-opus-4-8
# VIGIL_MODEL_DRAFT=claude-opus-4-8
# VIGIL_DB=vigil.db
